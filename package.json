{
  "name": "@chenkai114/dsh-team-admin",
  "version": "0.1.4",
  "description": "DSH 插件：GUI 管理任意会话的智能体团队 —— 查看成员、删除角色并清理其持久会话（进回收站，可恢复）",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "requires": {
      "dsh": ">=0.2.0-alpha.1 <0.3.0"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-team",
    "team",
    "admin"
  ],
  "license": "MIT",
  "author": "chenkai2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chenkai2/dsh-team-admin.git"
  },
  "bugs": {
    "url": "https://github.com/chenkai2/dsh-team-admin/issues"
  },
  "homepage": "https://github.com/chenkai2/dsh-team-admin#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:real": "node tests/e2e/real-data.mjs",
    "test:pack": "npm pack --dry-run"
  }
}
